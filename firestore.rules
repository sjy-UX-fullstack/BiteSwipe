rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own profile + subcollections
    // (saved recipes, pantry, cookHistory, etc.).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public recipes collection (read-only for clients).
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    // Trending recipes (refreshed weekly by serverless cron — read-only for clients).
    match /trending_recipes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-curated Instagram reel URLs (managed in Firebase Console).
    // Server cron reads these via service account; clients should not.
    match /curated_instagram/{id} {
      allow read, write: if false;
    }
  }
}
