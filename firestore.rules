rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own profile + subcollections
    // (saved recipes, pantry, cookHistory, shoppingList, mealPlan, etc.).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public recipes collection (read-only for clients).
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
